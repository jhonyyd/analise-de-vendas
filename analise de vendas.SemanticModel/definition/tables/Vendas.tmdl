table Vendas
	lineageTag: 53b88327-944b-4cab-9cd9-775200c0aba6

	/// Soma dos valores originais e recuperados. Sem moeda definida na fonte. Nao representa lucro nem receita liquida.
	measure Faturamento = SUM(Vendas[Valor Venda])
		formatString: #,0.00
		displayFolder: Indicadores
		lineageTag: a78da819-b552-431b-9842-e2590d029357

	measure Transacoes = DISTINCTCOUNT(Vendas[Transaction ID])
		formatString: #,0
		displayFolder: Indicadores
		lineageTag: ebb008a2-805b-458b-9591-2b0056a76765

	measure 'Transacoes com valor' = COUNT(Vendas[Valor Venda])
		formatString: #,0
		displayFolder: Indicadores
		lineageTag: bf86c659-65d2-4d51-9cbc-af9b3237489a

	/// Faturamento dividido somente pelas transacoes com valor conhecido, no contexto dos filtros.
	measure 'Ticket medio' = DIVIDE([Faturamento], [Transacoes com valor])
		formatString: #,0.00
		displayFolder: Indicadores
		lineageTag: 425c0721-9c52-486d-928e-0662f80111d7

	/// Soma de quantidades originais e recuperaveis. Nao inclui quantidades desconhecidas.
	measure Unidades = SUM(Vendas[Quantidade Analise])
		formatString: #,0.##
		displayFolder: Indicadores
		lineageTag: 16ff2fe1-6863-4ef8-842c-f1699d294768

	measure Clientes = DISTINCTCOUNT(Vendas[Customer ID])
		formatString: #,0
		displayFolder: Indicadores
		lineageTag: 06cf6a22-d281-4bee-b9b8-2b24622ee841

	measure 'Valores recuperados' = COALESCE(CALCULATE([Transacoes], KEEPFILTERS(Vendas[Status Valor] = "Recuperado: preco x quantidade")),0)
		formatString: #,0
		displayFolder: Qualidade
		lineageTag: c2934ac3-dba4-4430-8972-9af3412939de

	measure 'Vendas sem valor' = COALESCE(CALCULATE([Transacoes], KEEPFILTERS(Vendas[Status Valor] = "Sem valor recuperavel")),0)
		formatString: #,0
		displayFolder: Qualidade
		lineageTag: 01cb9ea9-4c07-405c-bcdd-716a60c072be

	measure 'Cobertura de valores' = DIVIDE([Transacoes com valor],[Transacoes])
		formatString: 0.0%
		displayFolder: Qualidade
		lineageTag: 763eb61a-5ee2-4870-b557-b5efa267354e

	measure 'Produtos nao informados' = COALESCE(CALCULATE([Transacoes], KEEPFILTERS(Vendas[Produto] = "Nao informado")),0)
		formatString: #,0
		displayFolder: Qualidade
		lineageTag: 7e76c0dc-a7d9-4938-a0d6-8e2bbe9d9762

	measure 'Descontos nao informados' = COALESCE(CALCULATE([Transacoes], KEEPFILTERS(Vendas[Desconto] = "Nao informado")),0)
		formatString: #,0
		displayFolder: Qualidade
		lineageTag: 2ac642d0-cf89-4974-a134-9ccb479682b2

	measure Divergencias = COALESCE(CALCULATE([Transacoes], KEEPFILTERS(Vendas[Divergencia] = "Divergente")),0)
		formatString: #,0
		displayFolder: Qualidade
		lineageTag: 3a72d6bb-f59d-4271-aadc-bc9b3d098760

