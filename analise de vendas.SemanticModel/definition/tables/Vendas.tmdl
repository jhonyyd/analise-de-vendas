	column Categoria
		dataType: string
		lineageTag: 00b980c4-f916-4c2a-86d2-8fdfc89b7a63
		summarizeBy: none
		sourceColumn: Categoria

	column Canal
		dataType: string
		lineageTag: caece191-638b-4049-9446-964bbab51c05
		summarizeBy: none
		sourceColumn: Canal

