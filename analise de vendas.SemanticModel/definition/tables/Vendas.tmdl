		lineageTag: 8160b16d-5f9f-4206-80ca-2af90ad9e75f
		summarizeBy: none
		sourceColumn: Valor Venda

	column 'Quantidade Analise'
		dataType: double
		lineageTag: 493972ac-df4d-4b9b-ad05-c0a8adb8d328
		summarizeBy: none
