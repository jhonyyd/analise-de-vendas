	column 'Status Valor'
		dataType: string
		lineageTag: 1f11ac44-6154-4542-92b8-0e81fcb2093d
		summarizeBy: none
		sourceColumn: Status Valor

	column Divergencia
		dataType: string
		lineageTag: 60a80ba6-6b4f-4ac9-99bb-770af0a4bdb2
		summarizeBy: none
		sourceColumn: Divergencia

	partition Vendas = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(CaminhoCSV), [Delimiter=",", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Limpos = Table.TransformColumns(Cabecalhos, List.Transform(Table.ColumnNames(Cabecalhos), (c) => {c, each if _ = null or Text.Trim(Text.From(_)) = "" then null else Text.Trim(Text.From(_)), type nullable text})),
				    Tipos = Table.TransformColumnTypes(Limpos, {{"Price Per Unit", type number}, {"Quantity", type number}, {"Total Spent", type number}, {"Transaction Date", type date}}, "en-US"),
				    Valor = Table.AddColumn(Tipos, "Valor Venda", each if [Total Spent] <> null then [Total Spent] else if [Price Per Unit] <> null and [Quantity] <> null then [Price Per Unit] * [Quantity] else null, type nullable number),
				    Quantidade = Table.AddColumn(Valor, "Quantidade Analise", each if [Quantity] <> null then [Quantity] else if [Total Spent] <> null and [Price Per Unit] <> null and [Price Per Unit] > 0 then [Total Spent] / [Price Per Unit] else null, type nullable number),
				    Categoria = Table.AddColumn(Quantidade, "Categoria", each Record.FieldOrDefault([Beverages="Bebidas", Butchers="Acougue", Food="Alimentos", Furniture="Moveis", Patisserie="Confeitaria", #"Milk Products"="Laticinios", #"Computers and electric accessories"="Informatica e acessorios", #"Electric household essentials"="Eletrodomesticos"], [Category], [Category]), type text),
				    Canal = Table.AddColumn(Categoria, "Canal", each if [Location] = "Online" then "Online" else if [Location] = "In-store" then "Loja fisica" else [Location], type text),
				    Pagamento = Table.AddColumn(Canal, "Pagamento", each if [Payment Method] = "Cash" then "Dinheiro" else if [Payment Method] = "Credit Card" then "Cartao de credito" else if [Payment Method] = "Digital Wallet" then "Carteira digital" else [Payment Method], type text),
				    Produto = Table.AddColumn(Pagamento, "Produto", each if [Item] = null then "Nao informado" else [Item], type text),
				    Desconto = Table.AddColumn(Produto, "Desconto", each if [Discount Applied] = null then "Nao informado" else if Text.Lower([Discount Applied]) = "true" then "Com desconto" else if Text.Lower([Discount Applied]) = "false" then "Sem desconto" else "Nao informado", type text),
				    Status = Table.AddColumn(Desconto, "Status Valor", each if [Total Spent] <> null then "Original" else if [Valor Venda] <> null then "Recuperado: preco x quantidade" else "Sem valor recuperavel", type text),
				    Divergencia = Table.AddColumn(Status, "Divergencia", each if [Total Spent] = null or [Price Per Unit] = null or [Quantity] = null then "Sem verificacao completa" else if Number.Abs([Total Spent] - [Price Per Unit] * [Quantity]) > 0.01 then "Divergente" else "Consistente", type text)
				in
				    Divergencia

